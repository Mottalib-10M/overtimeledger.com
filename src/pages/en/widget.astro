---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const frames = [
  { slug: 'time-card', title: 'Weekly time card with breaks, rounding and state overtime', h: 1500, who: 'Small businesses, staffing agencies, union locals and workers’ centers' },
  { slug: 'military-time', title: 'Military time converter', h: 520, who: 'Hospitals, security firms, schools and dispatch centers' },
];
const code = (f: (typeof frames)[number]) => `<iframe src="${SITE_URL}/embed/${f.slug}/" title="${f.title}" width="100%" height="${f.h}" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the time card calculator on your site, free of charge" description="Embed the weekly time card calculator, with breaks, rounding and state overtime, or the military time converter on your own site with one iframe line. No cookie, no tracking." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed the time card', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed the time card' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">Embed the time card</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code. When a state changes its overtime rule, the embedded calculator follows on its own.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <p>Terms: keep the credit link under the calculator visible, do not alter the frame, and present results as estimates of hours and gross pay. The frame sets no cookie and sends nothing about your visitors to us. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
    {frames.map((f) => <><h2>{f.title}</h2><p>Useful for: {f.who}.</p><pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code(f)}</code></pre></>)}
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/time-card/" title="Weekly time card with breaks, rounding and state overtime" width="100%" height="1500" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
